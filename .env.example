# ─── Routage (côté serveur uniquement — jamais exposé au navigateur) ───────
# Moteur : "ors" (OpenRouteService) ou "demo" (tracés géométriques hors ligne, pour développer sans clé)
ROUTING_PROVIDER=ors
# Clé gratuite : https://openrouteservice.org/dev/#/signup → Dashboard → Tokens
ORS_API_KEY=
# (optionnel) instance ORS auto-hébergée
# ORS_BASE_URL=https://api.openrouteservice.org

# ─── Politesse envers les services OSM (Photon, Overpass) ─────────────────
# Ajouté au User-Agent pour qu'ils puissent te contacter en cas de problème.
CONTACT_EMAIL=
# (optionnel) autres instances
# PHOTON_URL=https://photon.komoot.io
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ─── Carte (public) ────────────────────────────────────────────────────────
# Style MapLibre. Autres styles OpenFreeMap : liberty, bright, positron, fiord
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# ─── Supabase (public : protégé par RLS) — laisser vide = mode 100 % local ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
